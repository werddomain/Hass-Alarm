@using Hass_Alarm.Areas.Admin.Models.Users
@model List<UserManagementViewModel>

@{
    ViewData["Title"] = "User Management";
}

<h1>User Management</h1>

<p class="text-muted">Manage users, their access, and PIN codes</p>

<table class="table table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Roles</th>
            <th>PIN Code</th>
            <th>PIN Status</th>
            <th>User Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.IsLocked ? "table-warning" : "")">
                <td>
                    <strong>@item.User.UserName</strong>
                    @if (item.IsPowerUser)
                    {
                        <span class="badge badge-danger ml-2">Power User</span>
                    }
                </td>
                <td>@item.User.Email</td>
                <td>
                    @if (item.IsAdmin)
                    {
                        <span class="badge badge-primary">Admin</span>
                    }
                    @if (item.IsManager)
                    {
                        <span class="badge badge-info">Manager</span>
                    }
                    @if (item.IsMember)
                    {
                        <span class="badge badge-secondary">Member</span>
                    }
                </td>
                <td>
                    @if (item.PinCode != null)
                    {
                        <div>
                            <strong>@item.PinCode.Name</strong><br />
                            <small class="text-muted">PIN: ****</small>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">No PIN</span>
                    }
                </td>
                <td>
                    @if (item.PinCode != null)
                    {
                        @if (item.PinCode.Enabled)
                        {
                            <span class="badge badge-success">Enabled</span>
                        }
                        else
                        {
                            <span class="badge badge-secondary">Disabled</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>
                    @if (item.IsLocked)
                    {
                        <span class="badge badge-warning">Locked</span>
                    }
                    else
                    {
                        <span class="badge badge-success">Active</span>
                    }
                </td>
                <td>
                    @if (!item.IsPowerUser)
                    {
                        <div class="btn-group" role="group">
                            <!-- Toggle User Lock -->
                            <form asp-action="ToggleUserLock" method="post" style="display: inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.User.Id" />
                                @if (item.IsLocked)
                                {
                                    <button type="submit" class="btn btn-sm btn-success" title="Unlock User">
                                        <i class="mdi mdi-lock-open"></i> Unlock
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-warning" title="Lock User" onclick="return confirm('Are you sure you want to lock this user?');">
                                        <i class="mdi mdi-lock"></i> Lock
                                    </button>
                                }
                            </form>

                            <!-- Toggle PIN Enabled -->
                            @if (item.PinCode != null)
                            {
                                <form asp-action="TogglePinEnabled" method="post" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@item.User.Id" />
                                    @if (item.PinCode.Enabled)
                                    {
                                        <button type="submit" class="btn btn-sm btn-secondary" title="Disable PIN">
                                            <i class="mdi mdi-key-remove"></i> Disable PIN
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-primary" title="Enable PIN">
                                            <i class="mdi mdi-key-plus"></i> Enable PIN
                                        </button>
                                    }
                                </form>
                            }
                            else
                            {
                                <a asp-action="CreatePin" asp-route-userId="@item.User.Id" class="btn btn-sm btn-primary">
                                    <i class="mdi mdi-key-plus"></i> Create PIN
                                </a>
                            }

                            <!-- Edit and Delete -->
                            <a asp-action="Edit" asp-route-id="@item.User.Id" class="btn btn-sm btn-info">
                                <i class="mdi mdi-pencil"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.User.Id" class="btn btn-sm btn-danger">
                                <i class="mdi mdi-delete"></i> Delete
                            </a>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">Protected</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    .btn-group {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }
    .btn-group form {
        margin: 0;
    }
</style>
